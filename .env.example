# Copy to .env and fill in. Never commit the real .env.

# Required — GPT-5.6 for Delta Analyst & Harness proposer
OPENAI_API_KEY=sk-...

# Required — E2B sandboxed execution of real / generated code
E2B_API_KEY=e2b_...

# Optional — private repos / higher GitHub rate limits for PR intake
GITHUB_TOKEN=

# Optional — widen the LLM budget for large PRs (seconds)
LEVER_LLM_TIMEOUT_SECONDS=240

# Optional — match the E2B sandbox Python to the host to avoid version mismatches
LEVER_SANDBOX_TEMPLATE=base
